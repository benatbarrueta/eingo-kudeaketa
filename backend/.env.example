APP_ENV=development
DATA_SOURCE=mock
CALENDAR_YEAR=2027
GOOGLE_DOCUMENT_ID=
GOOGLE_TAB_ID=
GOOGLE_CREDENTIALS_PATH=
GOOGLE_TABLE_INDEX=0
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Set DATA_SOURCE=sheets to use the spreadsheet as the source of truth.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Hoja 1
GOOGLE_SHEET_ID=0
# Automatic two-way sync runs only while the backend is running in sheets mode.
AUTO_SYNC=true
SYNC_INTERVAL_SECONDS=15
SYNC_STATE_PATH=.local-sync/state.json
