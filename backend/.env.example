# =============================================================================
# 1. Aplicación y conexión con el frontend
# =============================================================================
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173

# =============================================================================
# 2. Fuente de datos y año de la agenda
# =============================================================================
# mock     : demo en memoria; se pierde al reiniciar.
# database : agenda persistente en SQLite sincronizada con Google (bloque 3).
# sheets   : agenda en Google Sheets, con proyección en Docs.
# google   : agenda directamente en Google Docs.
DATA_SOURCE=mock
CALENDAR_YEAR=2027

# =============================================================================
# 3. Base de datos local — DATA_SOURCE=database
# =============================================================================
# Ruta relativa a backend/, independientemente del directorio de arranque.
# Este valor utiliza backend/.local-data/eingo.sqlite3.
DATABASE_PATH=.local-data/eingo.sqlite3

# Necesario en este proyecto al usar DATA_SOURCE=database.
# Completa los bloques 4 y 5. El primer ciclo puede importar datos
# y escribir en Google: consulta docs/database.md antes de activarlo.
GOOGLE_SYNC=true

# =============================================================================
# 4. Acceso a Google — modos google, sheets o database con GOOGLE_SYNC=true
# =============================================================================
# Ruta al JSON privado de la cuenta de servicio, solo en el servidor.
GOOGLE_CREDENTIALS_PATH=

# =============================================================================
# 5. Archivos de Google
# =============================================================================
# Google Docs — necesario en todos los modos conectados a Google.
# GOOGLE_TAB_ID puede quedar vacío si el documento no requiere elegir pestaña.
# GOOGLE_TABLE_INDEX es la posición de la tabla, empezando en 0.
GOOGLE_DOCUMENT_ID=
GOOGLE_TAB_ID=
GOOGLE_TABLE_INDEX=0

# Google Sheets — necesario en sheets y en database con GOOGLE_SYNC=true.
# GOOGLE_SHEET_ID es el identificador numérico de la pestaña (gid).
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Hoja 1
GOOGLE_SHEET_ID=0

# =============================================================================
# 6. Sincronización — sheets o database con GOOGLE_SYNC=true
# =============================================================================
# Comprobaciones periódicas mientras el backend está encendido.
# En database, false desactiva el sondeo periódico; se sigue sincronizando
# al abrir la web, al guardar y mediante el botón Sincronizar.
AUTO_SYNC=true

# Intervalo en segundos; el mínimo efectivo es 10.
SYNC_INTERVAL_SECONDS=15

# Referencia privada del modo sheets y de la migración a SQLite.
# Conserva este archivo entre reinicios. No lo añadas a Git.
SYNC_STATE_PATH=.local-sync/state.json

# =============================================================================
# 7. Copias de seguridad — DATA_SOURCE=database
# =============================================================================
# Copia al arrancar si corresponde y después cada hora, con el backend encendido.
AUTO_BACKUP=true

# Ruta relativa a backend/. Directorio privado y excluido de Git por defecto.
BACKUP_DIRECTORY=.local-data/backups

# Frecuencia en segundos (mínimo 60); 3600 equivale a una hora.
BACKUP_INTERVAL_SECONDS=3600

# Número de copias automáticas que se conservan por base de datos.
# Solo se retiran copias antiguas después de comprobar la nueva.
BACKUP_KEEP=48
